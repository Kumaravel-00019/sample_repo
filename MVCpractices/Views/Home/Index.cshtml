//design textbox and button and display the ai response in ajax call
@model MVCpractices.Models.ErrorViewModel
@{
    ViewData["Title"] = "Home Page";
    int x = "hello";
}
<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Enter your query below:</p>
    <input type="text" id="userInput" class="form-control" placeholder="Type your query here..." />
    <button id="submitBtn" class="btn btn-primary mt-2">Submit</button>
    <div id="response" class="mt-4"></div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#submitBtn').click(function () {
                var userInput = $('#userInput').val();
                $.ajax({
                    url: '@Url.Action("GetAiResponse", "Home")',
                    type: 'POST',
                    data: { prompt: userInput },
                    success: function (response) {
                        $('#response').html('<p><strong>AI Response:</strong> ' + response + '</p>');
                    },
                    error: function () {
                        $('#response').html('<p class="text-danger">An error occurred while processing your request.</p>');
                    }
                });
            });
        });
    </script>
}
